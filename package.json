{
  "name": "monitorss",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/backend-api",
    "services/bot-presence",
    "services/discord-rest-listener",
    "services/feed-requests",
    "services/user-feeds-next",
    "e2e"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=packages/contracts --workspace=packages/logger",
    "dev": "npm run dev --workspace=e2e",
    "e2e": "npm run e2e --workspace=e2e",
    "e2e:paddle": "npm run e2e:paddle --workspace=e2e",
    "e2e:web": "npm run e2e:web --workspace=e2e"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "allowScripts": [
    "bufferutil",
    "utf-8-validate",
    "esbuild",
    "@swc/core",
    "@sentry/cli",
    "msw",
    "mongodb-memory-server",
    "@monitorss/contracts",
    "@monitorss/logger",
    "unrs-resolver"
  ],
  "overrides": {
    "glob": "^12.0.0",
    "inflight": "^1.0.6",
    "eslint-plugin-unused-imports": "^3.0.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "undici": "^7.29.0",
    "find-my-way": "^9.7.0",
    "js-yaml": "^3.15.1",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.8.0",
    "undici": "^7.29.0"
  }
}
