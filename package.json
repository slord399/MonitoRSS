    "e2e:doctor": "tsx e2e/scripts/run-e2e.ts --doctor",
    "e2e:paddle": "tsx e2e/scripts/run-e2e.ts --project=e2e-paddle",
    "e2e:web": "tsx e2e/scripts/run-e2e.ts --project=e2e-web"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "allowScripts": [
    "bufferutil",
    "utf-8-validate",
    "esbuild",
    "@swc/core",
    "@sentry/cli",
    "msw",
    "mongodb-memory-server",
    "@monitorss/contracts",
    "@monitorss/logger",
    "unrs-resolver"
  ],
  "overrides": {
    "fast-uri": "^3.1.7",
    "undici": "^7.29.0",
    "qs": "6.16.0",
    "js-yaml": "^3.15.1",
    "lodash": "^4.18.1",
    "fastify": "^5.12.1",
    "form-data": "^4.0.1",
    "ws": "^8.21.0",
    "@babel/core": "^7.29.6",
    "@tootallnate/once": "2.0.1",
    "braces": "^3.0.3",
    "flatted": "^3.4.2",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.5",
    "glob": "^12.0.0",
    "inflight": "^1.0.6",
    "eslint-plugin-unused-imports": "^3.0.0",
    "brace-expansion": "^5.0.9",
    "find-my-way": "$find-my-way",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0",
    "@synzen/discord-rest": {
      "undici": "^6.28.0"
    }
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
