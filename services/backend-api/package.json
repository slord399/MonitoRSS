{
  "name": "backend-api",
  "main": "dist/main.js",
  "private": true,
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.1.1",
    "@fastify/static": "^10.1.2",
    "@monitorss/logger": "file:../../packages/logger",
    "@monitorss/contracts": "file:../../packages/contracts",
    "@sinclair/typebox": "^0.34.48",
    "ajv": "^8.20.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "feedparser": "^2.2.10",
    "handlebars": "^4.7.8",
    "html-to-text": "^8.2.1",
    "lodash": "^4.18.1",
    "moment-timezone": "^0.5.46",
    "mongoose": "^7.6.2",
    "nodemailer": "^9.0.3",
    "qs": "^6.16.0",
    "rabbitmq-client": "^5.0.8",
    "undici": "^7.29.0",
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node ./dist/main.js",
    "start:schedule-emitter": "node ./dist/scripts/schedule-emitter.js",
    "start:legacy-feed-bulk-converter": "node ./dist/scripts/migrate-all-legacy-feeds.js",
    "dev": "tsx src/main.ts",
    "dev:schedule-emitter": "tsx watch src/scripts/schedule-emitter.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:docker": "bash test-e2e.sh",
    "enforce-limits": "tsx src/scripts/enforce-limits.ts",
    "migrate-legacy-feeds": "tsx src/scripts/migrate-all-legacy-feeds.ts",
    "recalculate-slots": "tsx src/scripts/recalculate-slot-offsets.ts",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:auth": "npx playwright codegen http://localhost:3000 --save-storage=e2e/auth.json",
    "e2e:auth:user2": "npx tsx e2e/auth-user2.ts",
    "e2e:report": "npx playwright show-report",
    "e2e:paddle": "npx playwright test --project=paddle"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/feedparser": "^2.2.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qs": "^6.15.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=12.0.1"
  },
  "overrides": {
    "glob": "^12.0.0",
    "inflight": {
      "once": "^1.4.0"
    },
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.15.1",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.3",
    "node-domexception": "^1.0.0",
    "undici": "$undici",
    "ejs": "^3.1.10",
    "axios": "^1.7.9",
    "qs": "$qs",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "path-to-regexp": "$path-to-regexp",
    "file-type": "^21.3.4",
    "@fastify/middie": "^9.3.3",
    "fast-uri": "^3.1.7",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^5.0.9",
    "fastify": "$fastify",
    "lodash": "$lodash",
    "ajv": "$ajv",
    "uuid": "^11.1.1",
    "@synzen/discord-rest": {
      "undici": "^5.28.5"
    }
  }
}
